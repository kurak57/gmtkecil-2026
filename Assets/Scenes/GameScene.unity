  dialogues:
  - phase: 1
    message: Hey
    greenChoice:
      word: HI
      type: 0
    redChoice:
      word: HELLO
      type: 1
  - phase: 1
    message: Have u eaten yet?
    greenChoice:
      word: YES
      type: 0
    redChoice:
      word: WHYASK
      type: 1
  - phase: 1
    message: What r u doing?
    greenChoice:
      word: WORK
      type: 0
    redChoice:
      word: NOTHING
      type: 1
  - phase: 1
    message: I miss you.
    greenChoice:
      word: METOO
      type: 0
    redChoice:
      word: IDONT
      type: 1
  - phase: 1
    message: Reply to me, ok? :)
    greenChoice:
      word: OK
      type: 0
    redChoice:
      word: MAYBE
      type: 1
  - phase: 1
    message: Thank u
    greenChoice:
      word: LOVEU
      type: 0
    redChoice:
      word: BYE
      type: 1
  - phase: 1
    message: Still busy?
    greenChoice:
      word: ABIT
      type: 0
    redChoice:
      word: VERYBUSY
      type: 1
  - phase: 1
    message: U R taking a while...
    greenChoice:
      word: SORRY
      type: 0
    redChoice:
      word: DONTCARE
      type: 1
  - phase: 1
    message: been waiting for U...
    greenChoice:
      word: THANKU
      type: 0
    redChoice:
      word: IKNOW
      type: 1
  - phase: 1
    message: Am I bothering u?
    greenChoice:
      word: NO
      type: 0
    redChoice:
      word: YES
      type: 1
  - phase: 1
    message: R u there?
    greenChoice:
      word: YES
      type: 0
    redChoice:
      word: IAMNOT
      type: 1
  - phase: 1
    message: Why did U take so long?
    greenChoice:
      word: WORK
      type: 0
    redChoice:
      word: WHYCARE
      type: 1
  - phase: 1
    message: U saw my message, did u?
    greenChoice:
      word: YES
      type: 0
    redChoice:
      word: NO
      type: 1
  - phase: 2
    message: R U IGNORING ME?
    greenChoice:
      word: WHAT
      type: 0
    redChoice:
      word: PROVEIT
      type: 1
  - phase: 2
    message: DONT LIE TO ME
    greenChoice:
      word: IWONT
      type: 0
    redChoice:
      word: WHATEVER
      type: 1
  - phase: 2
    message: Please reply...
    greenChoice:
      word: IMHERE
      type: 0
    redChoice:
      word: STOP
      type: 1
  - phase: 2
    message: I've been waiting for u all this time.
    greenChoice:
      word: SORRY
      type: 0
    redChoice:
      word: WAIT
      type: 1
  - phase: 2
    message: u r never this slow.
    greenChoice:
      word: MYBAD
      type: 0
    redChoice:
      word: BUSY
      type: 1
  - phase: 2
    message: R u with someone else?
    greenChoice:
      word: NO
      type: 0
    redChoice:
      word: MAYBE
      type: 1
  - phase: 2
    message: I just want a reply...
    greenChoice:
      word: IMHERE
      type: 0
    redChoice:
      word: LATER
      type: 1
  - phase: 2
    message: I told u... I don't like it when u disappear.
    greenChoice:
      word: SORRY
      type: 0
    redChoice:
      word: CALMDOWN
      type: 1
  - phase: 2
    message: If u r busy, tell me.
    greenChoice:
      word: IWILL
      type: 0
    redChoice:
      word: CANT
      type: 1
  - phase: 2
    message: Just don't leave me wondering.
    greenChoice:
      word: OKAY
      type: 0
    redChoice:
      word: LEAVEME
      type: 1
  - phase: 2
    message: I've been thinking about u all day.
    greenChoice:
      word: MISSUTOO
      type: 0
    redChoice:
      word: WHY
      type: 1
  - phase: 2
    message: But u can't even reply once.
    greenChoice:
      word: IMSORRY
      type: 0
    redChoice:
      word: IMBUSY
      type: 1
  - phase: 2
    message: Am I rlly that unimportant to u?
    greenChoice:
      word: NEVER
      type: 0
    redChoice:
      word: IDONTKNOW
      type: 1
  - phase: 2
    message: I'm scared of losing u...
    greenChoice:
      word: IMHERE
      type: 0
    redChoice:
      word: STOP
      type: 1
  - phase: 3
    message: pager breaks outside.
    greenChoice:
      word: BUG
      type: 0
    redChoice:
      word: URFAULT
      type: 1
  - phase: 3
    message: Im going for a walk. Guess where?
    greenChoice:
      word: PARK
      type: 0
    redChoice:
      word: NOWHERE
      type: 1
  - phase: 3
    message: I'm standing at ur street.
    greenChoice:
      word: WHY
      type: 0
    redChoice:
      word: GOAWAY
      type: 1
  - phase: 3
    message: Your bedroom light is on.
    greenChoice:
      word: HI
      type: 0
    redChoice:
      word: STALKER
      type: 1
  - phase: 3
    message: Why did u close the curtains?
    greenChoice:
      word: COLD
      type: 0
    redChoice:
      word: WINDOW
      type: 1
  - phase: 3
    message: Don't shut me out baby
    greenChoice:
      word: YES
      type: 0
    redChoice:
      word: NOWAY
      type: 1
  - phase: 3
    message: If u cut me off, I'll just come inside.
    greenChoice:
      word: WAIT
      type: 0
    redChoice:
      word: PLEASENO
      type: 1
  - phase: 3
    message: I'm in ur front yard. The grass is wet.
    greenChoice:
      word: HUH
      type: 0
    redChoice:
      word: GOAWAY
      type: 1
  - phase: 3
    message: Why did u lock ur door?
    greenChoice:
      word: SAFE
      type: 0
    redChoice:
      word: BLOCKYOU
      type: 1
  - phase: 3
    message: I have a spare key. I made it.
    greenChoice:
      word: HOW
      type: 0
    redChoice:
      word: ILLEGAL
      type: 1
  - phase: 4
    message: I'm inside. ur hallway is dark.
    greenChoice:
      word: HIDE
      type: 0
    redChoice:
      word: SEARCH
      type: 1
  - phase: 4
    message: I can hear ur heartbeat from here.
    greenChoice:
      word: CALM
      type: 0
    redChoice:
      word: SCARED
      type: 1
  - phase: 4
    message: dont call the police baby. Its just u and me.
    greenChoice:
      word: US
      type: 0
    redChoice:
      word: POLICE
      type: 1
  - phase: 4
    message: I'm standing right outside ur door
    greenChoice:
      word: DOOR
      type: 0
    redChoice:
      word: BLOCKIT
      type: 1
  - phase: 4
    message: I wonder where u r hiding...
    greenChoice:
      word: BED
      type: 0
    redChoice:
      word: NOWHERE
      type: 1
  - phase: 5
    message: If u move even a muscle, I'll punish u.
    greenChoice:
      word: STILL
      type: 0
    redChoice:
      word: CONFRONT
      type: 1
  - phase: 5
    message: Is this ur room?
    greenChoice:
      word: YES
      type: 0
    redChoice:
      word: GOAWAY
      type: 1
  - phase: 5
    message: The doorknob is turning. R u ready?
    greenChoice:
      word: YES
      type: 0
    redChoice:
      word: REFUSE
      type: 1
  - phase: 5
    message: The door is jammed! What did you put against it?!
    greenChoice:
      word: DESK
      type: 0
    redChoice:
      word: DRESSER
      type: 1
  - phase: 5
    message: You can't keep me away! I love you too much!
    greenChoice:
      word: STOP
      type: 0
    redChoice:
      word: PLEASENO
      type: 1
  - phase: 5
    message: I'M BREAKING IT DOWN! HERE I COME!
    greenChoice:
      word: HUG
      type: 0
    redChoice:
      word: SURVIVE
      type: 1
